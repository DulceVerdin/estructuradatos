  <property name="styleSheet">
   <string notr="true">/* Fondo del Dialog principal */
QDialog {
    background-color: #D85A77; /* Un rosa magenta saturado pero maduro y elegante */
    font-family: &quot;Segoe UI&quot;, -apple-system, Arial, sans-serif;
}

/* Etiquetas de texto estáticas */
QLabel {
    color: #FFFFFF; /* Texto blanco para un contraste limpio y profesional */
    font-size: 13px;
    font-weight: bold;
}

/* Cuadros de resultado (Cambia 'label_posfija' y 'label_resultado' por tus ObjectName) */
QLabel#label_posfija, QLabel#label_resultado {
    background-color: #FCEAEF; /* Fondo rosa muy claro para hacer destacar el resultado */
    border: none;
    border-radius: 12px; /* Bordes notablemente redondeados */
    color: #4A1521; /* Texto ultra oscuro para lectura fácil */
    font-size: 16px;
    font-weight: bold;
    padding: 8px;
    qproperty-alignment: 'AlignCenter';
}

/* Caja de texto (Input) */
QLineEdit {
    background-color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 6px 12px;
    color: #333333;
    font-size: 13px;
}

QLineEdit:focus {
    background-color: #FFF2F5;
}

/* Botones */
QPushButton {
    background-color: #63192B; /* Botones guinda/vino oscuro que contrastan hermoso con el rosa */
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #7A2237;
}

QPushButton:pressed {
    background-color: #4D111F;
}</string>
