  <property name="styleSheet">
   <string notr="true">/* 1. Fondo principal de la ventana */
QDialog {
    background-color: #e06385; /* Color rosa/coral del fondo */
}

/* 2. Etiquetas de texto normales (como &quot;Ingresa una Expresión Infija:&quot;) */
QLabel {
    color: #1a1a1a;
    font-size: 10pt;
    font-weight: bold;
    font-family: &quot;Segoe UI&quot;, Arial, sans-serif;
}

/* 3. El recuadro grande de abajo donde se muestran los resultados */
/* NOTA: Cambia #lbl_resultado y #lbl_resultado2 por los objectName de tus etiquetas */
#lbl_resultado, #lbl_resultado2 {
    background-color: #fae1e6; /* Rosa extremadamente claro/blanquecino */
    border: 2px dashed #c93b63; /* Borde punteado sutil como el de la foto */
    border-radius: 12px;        /* Esquinas muy redondeadas */
    color: #212121;
    font-size: 12pt;
    font-weight: bold;
}

/* 4. Caja de texto para ingresar la expresión (Line Edit) */
QLineEdit {
    background-color: #ffffff;  /* Fondo completamente blanco */
    border: 1px solid #c93b63;
    border-radius: 6px;         /* Esquinas redondeadas suaves */
    padding: 5px 10px;
    color: #212121;
    font-size: 11pt;
}

/* 5. Botones (Push Buttons) */
QPushButton {
    background-color: #c93b63;  /* Rosa fuerte/fucsia oscuro del botón */
    color: #ffffff;             /* Texto blanco */
    border-radius: 8px;         /* Esquinas redondeadas */
    font-weight: bold;
    font-size: 10pt;
    padding: 8px 18px;
}

/* Efecto visual cuando pasas el mouse por encima del botón */
QPushButton:hover {
    background-color: #b02f53;
}

/* Efecto visual cuando haces clic en el botón */
QPushButton:pressed {
    background-color: #942342;
}</string>
