  <property name="styleSheet">
   <string notr="true">/* Estilo para el diálogo principal */
QDialog {
    background-color: #FCE4EC; /* Rosa pastel muy suave */
    font-family: &quot;Segoe UI&quot;, sans-serif;
    font-size: 14px;
}

/* Estilo para los botones */
QPushButton {
    background-color: #D81B60; /* Fucsia intenso para acento */
    color: white;
    border-radius: 10px;
    padding: 10px 15px;
    border: none;
    font-weight: bold;
    text-align: left; /* Alinear texto e icono a la izquierda */
}

/* Efecto al pasar el ratón por encima de los botones */
QPushButton:hover {
    background-color: #AD1457; /* Un tono más oscuro */
}

/* Efecto al presionar los botones */
QPushButton:pressed {
    background-color: #880E4F; /* Aún más oscuro */
    padding-left: 12px; /* Pequeño efecto de desplazamiento */
    padding-top: 12px;
}

/* Estilo para el campo de entrada de texto */
QLineEdit {
    background-color: #FFFDE7; /* Crema muy suave */
    border: 1px solid #C2185B;
    border-radius: 8px;
    padding: 8px;
    color: #333;
}

QLineEdit:focus {
    border: 2px solid #D81B60; /* Borde más grueso al enfocar */
}

/* Estilo para el área de texto grande (registro) */
QTextEdit {
    background-color: #FFFDE7; /* Crema muy suave */
    border: 2px solid #C2185B;
    border-radius: 10px;
    padding: 10px;
    color: #333;
    font-family: &quot;Consolas&quot;, monospace; /* Fuente monoespaciada para logs */
    font-size: 13px;
}

/* Estilo para las etiquetas de texto */
QLabel {
    color: #444;
    background: transparent;
}</string>
