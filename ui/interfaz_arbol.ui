  <property name="styleSheet">
   <string notr="true">/* Fondo principal de la ventana */
QWidget#EvaluadorArboles {
    background-color: #e06385;
    font-family: &quot;Segoe UI&quot;, Arial, sans-serif;
}

/* Etiquetas de texto generales */
QLabel {
    color: #ffffff;
    font-size: 10pt;
    font-weight: bold;
}

/* Caja de entrada (QLineEdit) */
QLineEdit {
    background-color: #ffffff;
    border: 2px solid #c93b63;
    border-radius: 8px;
    padding: 5px 10px;
    color: #212121;
    font-size: 10pt;
}

/* Botones principales */
QPushButton {
    background-color: #c93b63;
    color: #ffffff;
    border-radius: 10px;
    font-weight: bold;
    font-size: 10pt;
    padding: 6px 12px;
}

QPushButton:hover {
    background-color: #b02f53;
}

QPushButton:pressed {
    background-color: #942342;
}

/* Marco de Resultados y Caja de Texto del Árbol */
QFrame#frame_resultados, QTextEdit#txt_tree {
    background-color: #fae1e6;
    border: 2px dashed #c93b63;
    border-radius: 12px;
    color: #212121;
}

/* Ajuste de fuente para el árbol visual */
QTextEdit#txt_tree {
    font-family: &quot;Consolas&quot;, &quot;Courier New&quot;, monospace;
    font-size: 11pt;
    padding: 8px;
}

/* Texto dentro del cuadro de resultados */
QFrame#frame_resultados QLabel {
    color: #212121;
    font-size: 9pt;
}
</string>
